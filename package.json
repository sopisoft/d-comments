{
  "name": "d-comments",
  "displayName": "d-anime comments viewer",
  "version": "2026.9.30",
  "private": true,
  "description": "dアニメストアでニコニコ動画のコメントを表示するブラウザ拡張機能",
  "license": "GPL-3.0",
  "author": "sopi",
  "type": "module",
  "scripts": {
    "dev": "pnpm run /^dev:.*/",
    "dev:chrome": "wxt -b chrome",
    "dev:firefox": "wxt -b firefox",
    "build": "pnpm run /^build:.*/",
    "build:chrome": "wxt build -b chrome --mv3",
    "build:firefox": "wxt build -b firefox --mv2",
    "zip": "pnpm run /^zip:.*/",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "postinstall": "wxt prepare",
    "test:e2e": "node scripts/e2e.ts",
    "test:e2e:headed": "node scripts/e2e.ts --headed",
    "test:e2e:debug": "node scripts/e2e.ts --debug",
    "auth:chrome": "node scripts/chrome-auth.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test:storybook": "vitest --run",
    "format": "oxfmt"
  },
  "dependencies": {
    "@mantine/core": "^9.6.3",
    "@mantine/form": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@xpadev-net/niconicomments": "^0.4.1",
    "pixi.js": "^8.21.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-virtuoso": "^4.18.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "@wxt-dev/module-react": "^1.2.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "react-icons": "^5.7.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "storybook": "^10.6.1",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "wxt": "0.21.4"
  },
  "packageManager": "pnpm@12.8.1"
}